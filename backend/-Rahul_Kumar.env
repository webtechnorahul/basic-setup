PORT=3000
JWT_SECRET=your-secret-jwt token
MONGODB_URI=your databse url
GOOGLE_CLIENT_ID=google-client-id provide by google 
GOOGLE_CLIENT_SECRET=google-client-secret provide by google
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback #your google auth callback url
GOOGLE_REFRESH_EMAIL_KEY=refresh token provide by gmail api provide by google
GOOGLE_EMAIL_USER=your email-id which is used to generate refresh token